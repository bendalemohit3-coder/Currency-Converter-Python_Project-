print(" ***** CURRENCY CONVERTER ***** ")

currencies = {
    "INR": 1.0,
    "USD": 85.0,
    "JPY": 0.57,
    "EUR": 98.0,
    "GBP": 115.0,
    "CNY": 12.0,
    "CHF": 105.0,
    "AUD": 56.0,
    "CAD": 62.0,
    "HKD": 11.0,
    "SGD": 65.0
}

names = {
    "INR": "Indian Rupee",
    "USD": "US Dollar",
    "JPY": "Japanese Yen",
    "EUR": "Euro",
    "GBP": "UK Pound",
    "CNY": "Chinese Yuan",
    "CHF": "Swiss Franc",
    "AUD": "Australian Dollar",
    "CAD": "Canadian Dollar",
    "HKD": "Hong Kong Dollar",
    "SGD": "Singapore Dollar"
}

print("\nAvailable Currencies:")

codes = list(currencies.keys())

for i in range(len(codes)):
    print(i + 1, ".", names[codes[i]], "(", codes[i], ")")

source_choice = int(input("\nChoose source currency number: "))
target_choice = int(input("Choose target currency number: "))

if 1 <= source_choice <= len(codes) and 1 <= target_choice <= len(codes):

    source = codes[source_choice - 1]
    target = codes[target_choice - 1]

    amount = float(input("Enter amount: "))

    inr = amount * currencies[source]
    result = inr / currencies[target]

    print("\n========== RESULT ==========")
    print(amount, source, "=", round(result, 2), target)
    print("============================")

else:
    print("Invalid currency number!")

